<Window x:Class="YTMusicLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="YT Music Launcher - YouTube Music Standalone with AdBlocker &amp; Downloader"
        Height="820" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#121212" Foreground="#FFFFFF"
        PreviewKeyDown="OnWindowKeyDown">

    <Window.Resources>
        <Style TargetType="Button" x:Key="NavTabButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" 
                                CornerRadius="4,4,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="Background" Value="#222222"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="ActiveNavTabButtonStyle" BasedOn="{StaticResource NavTabButtonStyle}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#FF0000"/>
            <Setter Property="Background" Value="#1E1E1E"/>
        </Style>

        <Style TargetType="Button" x:Key="ActionButtonStyle">
            <Setter Property="Background" Value="#FF0000"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CC0000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryActionButtonStyle">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3D3D3D"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#383838"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="PlayPausePlayerControlStyle">
            <Setter Property="Background" Value="#FF0000"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E50914"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="CirclePlayerControlStyle">
            <Setter Property="Background" Value="#2C2C2C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#444444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="TableActionButtonStyle">
            <Setter Property="Background" Value="#262626"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3D3D3D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox" x:Key="DarkTextBoxStyle">
            <Setter Property="Background" Value="#242424"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Header Navbar -->
            <RowDefinition Height="60"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Bottom Local Player Bar (Only visible or active for Library) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER NAVBAR -->
        <Border Grid.Row="0" Background="#181818" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo & App Name -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="🎵" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="YT MUSIC" FontSize="18" FontWeight="Black" Foreground="#FF0000" VerticalAlignment="Center"/>
                    <TextBlock Text=" LAUNCHER" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <Border Background="#282828" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="uBlock Active" FontSize="10" Foreground="#00FF88" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <!-- Navigation Tabs -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button x:Name="BtnTabYtMusic" Content="🎵 YouTube Music" Style="{StaticResource ActiveNavTabButtonStyle}" Click="OnTabYtMusicClick"/>
                    <Button x:Name="BtnTabLibrary" Content="📚 Biblioteca" Style="{StaticResource NavTabButtonStyle}" Click="OnTabLibraryClick"/>
                    <Button x:Name="BtnTabDownloads" Content="⬇️ Descargas" Style="{StaticResource NavTabButtonStyle}" Click="OnTabDownloadsClick"/>
                </StackPanel>

                <!-- Right Side Quick Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🎵 Descargar Canción" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Click="OnQuickDownloadSingleClick" ToolTip="Descarga la canción actual"/>
                    <Button Content="📜 Descargar Playlist" Style="{StaticResource SecondaryActionButtonStyle}" Margin="0,0,10,0" Click="OnQuickDownloadPlaylistClick" ToolTip="Descarga la playlist completa"/>
                    <Button Content="📁 Carpeta" Background="#2A2A2A" Foreground="#FFFFFF" FontSize="12" Padding="10,6" BorderThickness="0" Cursor="Hand" Click="OnOpenFolderClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT VIEWS -->
        <Grid Grid.Row="1">

            <!-- VIEW 1: YOUTUBE MUSIC WEBVIEW -->
            <Grid x:Name="ViewYtMusic" Visibility="Visible">
                <wv2:WebView2 x:Name="YtWebView"/>
            </Grid>

            <!-- VIEW 2: BIBLIOTECA (LOCAL MUSIC LIBRARY) -->
            <Grid x:Name="ViewLibrary" Visibility="Collapsed" Background="#121212">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Sidebar: Playlists & Filter + Create Playlist Button -->
                <Border Grid.Column="0" Background="#181818" BorderBrush="#262626" BorderThickness="0,0,1,0" Padding="12">
                    <DockPanel>
                        <!-- Header & Create Playlist Button -->
                        <Grid DockPanel.Dock="Top" Margin="0,4,0,12">
                            <TextBlock Text="PLAYLISTS" FontSize="12" FontWeight="Bold" Foreground="#888888" VerticalAlignment="Center"/>
                            <Button Content="+ Nueva" HorizontalAlignment="Right" Background="#FF0000" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" Padding="8,4" BorderThickness="0" Cursor="Hand" Click="OnOpenCreatePlaylistModalClick">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <ListBox x:Name="LstPlaylists" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" SelectionChanged="OnPlaylistSelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#CCCCCC"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#FF0000"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2A2A2A"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Center: Song Table & Advanced Search/Filter Bar -->
                <Grid Grid.Column="1" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Bar: Search Input + Genre Filter + Sorting + Stats -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Box -->
                        <TextBox x:Name="TxtSearchLibrary" Grid.Column="0" Style="{StaticResource DarkTextBoxStyle}" 
                                 Text="Buscar canción, artista o álbum..." Foreground="#888888" 
                                 GotFocus="OnSearchGotFocus" LostFocus="OnSearchLostFocus" TextChanged="OnSearchTextChanged" Margin="0,0,10,0"/>

                        <!-- Genre Filter -->
                        <ComboBox x:Name="CmbGenreFilter" Grid.Column="1" Background="#242424" Foreground="#FFFFFF" FontSize="13" Padding="8,6" Margin="0,0,10,0" VerticalContentAlignment="Center" SelectionChanged="OnGenreFilterChanged">
                            <ComboBoxItem Content="Todos los Géneros" IsSelected="True"/>
                        </ComboBox>

                        <!-- Sort By Selector -->
                        <ComboBox x:Name="CmbSortBy" Grid.Column="2" Background="#242424" Foreground="#FFFFFF" FontSize="13" Padding="8,6" Margin="0,0,10,0" VerticalContentAlignment="Center" SelectionChanged="OnSortByChanged">
                            <ComboBoxItem Content="Fecha (Más Recientes)" IsSelected="True"/>
                            <ComboBoxItem Content="Fecha (Más Antiguos)"/>
                            <ComboBoxItem Content="Título (A-Z)"/>
                            <ComboBoxItem Content="Artista (A-Z)"/>
                            <ComboBoxItem Content="Álbum (A-Z)"/>
                            <ComboBoxItem Content="Género (A-Z)"/>
                            <ComboBoxItem Content="Duración"/>
                        </ComboBox>

                        <!-- Stats & Refresh -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="LblLibraryStats" Text="0 Canciones" VerticalAlignment="Center" Foreground="#888888" FontSize="13" Margin="0,0,12,0"/>
                            <Button Content="🔄 Actualizar" Background="#2A2A2A" Foreground="#FFFFFF" Padding="12,8" BorderThickness="0" Cursor="Hand" Click="OnRefreshLibraryClick">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Songs ListGrid -->
                    <DataGrid x:Name="DgLibrary" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="Transparent" RowBackground="#161616" AlternatingRowBackground="#1B1B1B"
                              GridLinesVisibility="None" HeadersVisibility="Column" BorderThickness="0"
                              SelectionMode="Single" SelectionChanged="OnSongSelectionChanged" MouseDoubleClick="OnSongDoubleClick">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#222222"/>
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Height" Value="52"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#FF0000"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <!-- Cover Thumbnail -->
                            <DataGridTemplateColumn Header="" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="40" Height="40" CornerRadius="4" ClipToBounds="True" Background="#282828">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Title -->
                            <DataGridTextColumn Header="TÍTULO" Binding="{Binding Title}" Width="2*" FontWeight="Bold"/>

                            <!-- Artist -->
                            <DataGridTextColumn Header="ARTISTA" Binding="{Binding Artist}" Width="1.5*" Foreground="#CCCCCC"/>

                            <!-- Album -->
                            <DataGridTextColumn Header="ÁLBUM" Binding="{Binding Album}" Width="1.2*" Foreground="#888888"/>

                            <!-- Genre -->
                            <DataGridTextColumn Header="GÉNERO" Binding="{Binding Genre}" Width="1.1*" Foreground="#00FF88"/>

                            <!-- Duration -->
                            <DataGridTextColumn Header="DURACIÓN" Binding="{Binding DurationFormatted}" Width="85" Foreground="#AAAAAA"/>

                            <!-- Actions -->
                            <DataGridTemplateColumn Header="ACCIONES" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="▶" ToolTip="Reproducir" Click="OnPlayTrackClick" Style="{StaticResource TableActionButtonStyle}"/>
                                            <Button Content="📂" ToolTip="Abrir Ubicación" Click="OnOpenTrackLocationClick" Style="{StaticResource TableActionButtonStyle}"/>
                                            <Button Content="🗑" ToolTip="Eliminar" Click="OnDeleteTrackClick" Style="{StaticResource TableActionButtonStyle}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>

            <!-- VIEW 3: DESCARGAS (YTDLP DOWNLOADER WITH EXPANDABLE PLAYLIST DETAILS) -->
            <Grid x:Name="ViewDownloads" Visibility="Collapsed" Background="#121212" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Download Link Form Card -->
                <Border Grid.Row="0" Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Descargar Música o Playlists de YouTube / YT Music" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="TxtDownloadUrl" Grid.Column="0" Style="{StaticResource DarkTextBoxStyle}" 
                                     Text="Pega aquí la URL de la canción o playlist..." Foreground="#888888" 
                                     GotFocus="OnUrlGotFocus" LostFocus="OnUrlLostFocus" Margin="0,0,12,0"/>

                            <ComboBox x:Name="CmbFormat" Grid.Column="1" Background="#242424" Foreground="#FFFFFF" FontSize="13" Padding="10,8" Margin="0,0,12,0" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="MP3 (320 kbps)" IsSelected="True"/>
                                <ComboBoxItem Content="M4A (AAC Original)"/>
                                <ComboBoxItem Content="FLAC (Lossless)"/>
                                <ComboBoxItem Content="WAV (Audio Sin Comprimir)"/>
                            </ComboBox>

                            <Button Grid.Column="2" Content="⚡ Iniciar Descarga" Style="{StaticResource ActionButtonStyle}" Click="OnStartDownloadClick"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Active & Completed Downloads Queue -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Cola de Descargas" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" Content="Limpiar Completadas" Background="#2A2A2A" Foreground="#CCCCCC" Padding="10,6" BorderThickness="0" Cursor="Hand" Click="OnClearCompletedDownloadsClick">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="LstDownloads">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Row 1: Title, Format, Expand Button & Cancel Button -->
                                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                                                    <Button Content="▼ Ver Canciones" Click="OnToggleExpandPlaylistClick" Background="#282828" Foreground="#00FF88" FontSize="11" Padding="8,3" Margin="12,0,0,0" BorderThickness="0" Cursor="Hand">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPlaylist}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </StackPanel>

                                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                    <Border Background="#333333" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding QualityFormat}" FontSize="11" Foreground="#00FF88" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <Button Content="⏹️ Detener Todo" Background="#331111" Foreground="#FF5555" FontSize="11" FontWeight="Bold" Padding="8,4" BorderThickness="0" Cursor="Hand" Click="OnCancelDownloadClick">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CanCancel}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Row 2: Progress Bar -->
                                            <ProgressBar Grid.Row="1" Height="8" Value="{Binding Progress}" Maximum="100" Background="#2A2A2A" Foreground="#FF0000" Margin="0,0,0,8">
                                                <ProgressBar.Template>
                                                    <ControlTemplate TargetType="ProgressBar">
                                                        <Grid x:Name="TemplateRoot">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                                                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left"/>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </ProgressBar.Template>
                                            </ProgressBar>

                                            <!-- Row 3: Status Details -->
                                            <Grid Grid.Row="2" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#AAAAAA"/>
                                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Speed}" FontSize="12" Foreground="#888888" Margin="0,0,12,0"/>
                                                    <TextBlock Text="{Binding Eta, StringFormat='ETA: {0}'}" FontSize="12" Foreground="#888888"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Row 4: Expandable SubItems (Playlist Tracks) -->
                                            <Border Grid.Row="3" Background="#121212" CornerRadius="6" Padding="12" Margin="0,8,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <ItemsControl ItemsSource="{Binding SubItems}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="35"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="130"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0" Text="{Binding Index, StringFormat='#{0}'}" FontSize="12" Foreground="#888888" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="11" Foreground="#AAAAAA" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                                
                                                                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                                                    <Button Content="⏹ Skip" Background="#261818" Foreground="#FF6666" FontSize="10" FontWeight="Bold" Padding="6,2" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand" Click="OnSkipSubItemClick">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding CanSkip}" Value="False">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                                    <ContentPresenter/>
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>

                                                                    <Button Content="🛑 Detener desde aquí" Background="#3D1414" Foreground="#FF4444" FontSize="10" FontWeight="Bold" Padding="6,2" BorderThickness="0" Cursor="Hand" Click="OnCancelFromHereClick">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding CanSkip}" Value="False">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                                    <ContentPresenter/>
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

        </Grid>

        <!-- INLINE MODAL OVERLAY FOR CREATING NEW PLAYLIST WITH CHECKBOXES -->
        <Grid x:Name="PnlCreatePlaylistModal" Grid.RowSpan="3" Background="#AA000000" Visibility="Collapsed">
            <Border Background="#1C1C1C" BorderBrush="#333333" BorderThickness="1" CornerRadius="12" Width="680" Height="560" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0" Text="✨ Crear Nueva Playlist" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,16"/>

                    <!-- Playlist Name Input -->
                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Nombre de la Playlist:" FontSize="13" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtNewPlaylistName" Grid.Column="1" Style="{StaticResource DarkTextBoxStyle}" Text="Mi Lista Personalizada"/>
                    </Grid>

                    <!-- Search & Quick Selection Actions -->
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtModalSearch" Grid.Column="0" Style="{StaticResource DarkTextBoxStyle}" Text="Filtrar canciones..." Foreground="#888888" GotFocus="OnModalSearchGotFocus" LostFocus="OnModalSearchLostFocus" TextChanged="OnModalSearchTextChanged" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="☑️ Seleccionar Todo" Background="#2A2A2A" Foreground="#FFFFFF" FontSize="11" Padding="8,6" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand" Click="OnSelectAllModalClick">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Content="⬜ Deseleccionar" Background="#2A2A2A" Foreground="#CCCCCC" FontSize="11" Padding="8,6" BorderThickness="0" Cursor="Hand" Click="OnDeselectAllModalClick">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Tracks Selection ListGrid with Checkboxes -->
                    <DataGrid x:Name="DgModalTracks" Grid.Row="3" AutoGenerateColumns="False" 
                              Background="#141414" RowBackground="#161616" AlternatingRowBackground="#1A1A1A"
                              GridLinesVisibility="None" HeadersVisibility="Column" BorderThickness="0" Margin="0,0,0,16">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#252525"/>
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <!-- Checkbox Column -->
                            <DataGridCheckBoxColumn Header="AÑADIR" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                            <!-- Title -->
                            <DataGridTextColumn Header="TÍTULO" Binding="{Binding Track.Title}" Width="2*" IsReadOnly="True" FontWeight="Bold"/>
                            <!-- Artist -->
                            <DataGridTextColumn Header="ARTISTA" Binding="{Binding Track.Artist}" Width="1.5*" IsReadOnly="True" Foreground="#CCCCCC"/>
                            <!-- Album -->
                            <DataGridTextColumn Header="ÁLBUM" Binding="{Binding Track.Album}" Width="1.2*" IsReadOnly="True" Foreground="#888888"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Modal Actions -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="❌ Cancelar" Background="#2A2A2A" Foreground="#CCCCCC" Padding="16,8" Margin="0,0,12,0" BorderThickness="0" Cursor="Hand" Click="OnCloseNewPlaylistModalClick">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="💾 Guardar Playlist" Style="{StaticResource ActionButtonStyle}" Click="OnSaveNewPlaylistClick"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- HIGH-CONTRAST BOTTOM LOCAL AUDIO PLAYER BAR -->
        <Border Grid.Row="2" x:Name="PnlBottomPlayer" Background="#161616" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" Padding="16,12" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <!-- Track Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="50" Height="50" CornerRadius="8" ClipToBounds="True" Background="#282828" Margin="0,0,12,0">
                        <Image x:Name="ImgPlayerCover" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="LblPlayerTitle" Text="Canción" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                        <TextBlock x:Name="LblPlayerArtist" Text="Artista" FontSize="12" Foreground="#00FF88" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                    </StackPanel>
                </StackPanel>

                <!-- High-Contrast Player Controls & Slider -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="480">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <Button Content="⏮" Click="OnPlayerPrevClick" Style="{StaticResource CirclePlayerControlStyle}" Margin="0,0,14,0" ToolTip="Anterior"/>
                        <Button x:Name="BtnPlayerPlayPause" Content="▶" Click="OnPlayerPlayPauseClick" Style="{StaticResource PlayPausePlayerControlStyle}" Margin="0,0,14,0" ToolTip="Reproducir / Pausa"/>
                        <Button Content="⏭" Click="OnPlayerNextClick" Style="{StaticResource CirclePlayerControlStyle}" ToolTip="Siguiente"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="45"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="45"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblPlayerCurrentTime" Grid.Column="0" Text="00:00" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        <Slider x:Name="SldPlayerSeek" Grid.Column="1" Margin="10,0" Minimum="0" Maximum="100" Focusable="False"
                                PreviewMouseDown="OnSeekStarted" PreviewMouseUp="OnSeekCompleted" ValueChanged="OnSeekSliderValueChanged"/>
                        <TextBlock x:Name="LblPlayerTotalTime" Grid.Column="2" Text="00:00" FontSize="11" FontWeight="Bold" Foreground="#888888" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <!-- Volume -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="🔊" FontSize="14" Foreground="#FFFFFF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <Slider x:Name="SldPlayerVolume" Width="110" Minimum="0" Maximum="1" Value="0.8" Focusable="False" ValueChanged="OnVolumeSliderValueChanged" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
